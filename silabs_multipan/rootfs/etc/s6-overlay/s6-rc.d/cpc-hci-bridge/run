#!/usr/bin/with-contenv bashio
# vim: ft=bash
# shellcheck shell=bash
# ==============================================================================
# Start the CPC <-> HCI bridge (a pty speaking H4, attached by btattach)
# ==============================================================================
declare duty

duty=$(bashio::config 'bluetooth_max_scan_duty')
if [ "${duty}" -lt 100 ]; then
    # BlueZ scans at 100 % duty, which starves 802.15.4 on the shared radio
    export CPC_HCI_BRIDGE_MAX_SCAN_DUTY="${duty}"
    bashio::log.info "Capping the Bluetooth LE scan duty cycle at ${duty} %."
fi

mkdir -p /run/cpc-hci || bashio::exit.nok "Could not create /run/cpc-hci"
rm -f /run/cpc-hci/pts_hci

bashio::log.info "Starting cpc-hci-bridge..."
# The bridge creates pts_hci in its working directory; s6-notifyoncheck itself
# must stay in the service directory (./notification-fd, ./data/check)
exec s6-notifyoncheck -d -s 300 -w 300 -n 0 \
    /bin/sh -c 'cd /run/cpc-hci && exec /opt/multipan/bin/cpc-hci-bridge cpcd_0'
