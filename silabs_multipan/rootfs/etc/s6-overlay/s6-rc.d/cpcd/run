#!/usr/bin/with-contenv bashio
# vim: ft=bash
# shellcheck shell=bash
# ==============================================================================
# Start the Co-Processor Communication daemon (resets the RCP)
# ==============================================================================
bashio::log.info "Starting cpcd..."
exec s6-notifyoncheck -d -s 300 -w 300 -n 0 \
    /usr/bin/stdbuf -o0 /opt/multipan/bin/cpcd -c /etc/cpcd.conf
