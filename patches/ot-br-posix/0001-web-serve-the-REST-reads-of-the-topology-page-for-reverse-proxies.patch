+void WebServer::ResponseRestProxy(void)
+{
+    // The topology page reads otbr-agent's REST API, whose port a browser behind a reverse
+    // proxy (e.g. Home Assistant ingress) cannot reach: serve those reads from here.
+    for (const char *path : {"/node", "/diagnostics"})
+    {
+        mServer.Get(path, [path](const Request &aRequest, Response &aResponse) {
+            OTBR_UNUSED_VARIABLE(aRequest);
+            const char *host = getenv("OTBR_WEB_REST_HOST");
+            const char *port = getenv("OTBR_WEB_REST_PORT");
+
+            httplib::Client client(host != nullptr ? host : "127.0.0.1", port != nullptr ? atoi(port) : 8081);
+            client.set_read_timeout(30, 0);
+
+            if (auto result = client.Get(path))
+            {
+                aResponse.status = result->status;
+                aResponse.set_content(result->body, OT_RESPONSE_HEADER_TYPE);
+            }
+            else
+            {
+                aResponse.status = 502;
+            }
+        });
+    }
+}
