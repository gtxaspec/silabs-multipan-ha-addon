+// ftruncate(2) does not resize an existing mapping: writes past its old end fault (SIGSEGV), or
+// land on a page the file no longer backs (SIGBUS), so every resize maps the file again.
+static void resizeNvmFile(size_t size)
+{
+  if (ftruncate(fd, size) == -1) {
+    err(EX_IOERR, "Could not set size of " SL_ZIGBEE_AF_TOKEN_FILENAME);
+  }
+  if (nvm != MAP_FAILED) {
+    munmap(nvm, nvm_len);
+  }
+  nvm = mmap(NULL, size, (PROT_READ | PROT_WRITE), MAP_SHARED, fd, 0);
+  if (nvm == MAP_FAILED) {
+    err(EX_UNAVAILABLE, "Could not map " SL_ZIGBEE_AF_TOKEN_FILENAME " to memory");
+  }
+  nvm_len = size;
+}
